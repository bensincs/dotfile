# Local dependencies and validation artifacts
node_modules/
__pycache__/
/demos/
/tools/target/

# Stow-managed scripts override the global .local/ ignore.
!/zsh/.local/
!/zsh/.local/bin/
!/zsh/.local/bin/n
!/zsh/.local/bin/diffwatch

# Machine-local shell overrides may contain credentials.
.zshenv.local
.zshrc.local

# Generated per machine by "rex terminfo setup"; contains absolute paths.
rex/.config/rex/ssh_config
rex/.config/rex/terminfo-hosts
