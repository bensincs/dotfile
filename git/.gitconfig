[user]
	name = Ben Sinclair
	email = ben@sincs.co.uk
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
[credential "azrepos:org/CSECodeHub"]
	azureAuthority = https://login.microsoftonline.com/72f988bf-86f1-41af-91ab-2d7cd011db47
	username = bensinclair@microsoft.com
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[init]
	defaultBranch = main
[pull]
	rebase = false
[core]
	editor = code --wait
	pager = delta
	excludesfile = ~/.gitignore_global
[alias]
	ai = !opencode run /commit
# Match Kitty's Solarized Dark palette in Git diffs and diffnav.
[delta]
	dark = true
	syntax-theme = Solarized (dark)
	minus-style = syntax "#3b252c"
	minus-emph-style = syntax "#663033"
	plus-style = syntax "#183c32"
	plus-emph-style = syntax "#305039"
	line-numbers = true
	line-numbers-minus-style = "#dc322f"
	line-numbers-plus-style = "#859900"
	line-numbers-zero-style = "#586e75"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#268bd2" box
[credential "azrepos:org/incep-cortex"]
	azureAuthority = https://login.microsoftonline.com/5ac4936b-1ac4-4e57-9e2b-48673491865e
	username = bensinclair@microsoft.com
[credential "http://localhost:3000"]
	provider = generic
